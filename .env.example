# Environment Variables Configuration Example
# Copy this file to .env or set these environment variables in your deployment environment.
# DO NOT COMMIT THE ACTUAL .env FILE CONTAINING PRODUCTION SECRETS TO GIT.

# JWT Configuration
# Generates a 256-bit (or stronger) HMAC SHA-256 secret key. Must be a secure random hex or base64 string in production.
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Server Port
PORT=8080

# Default Seed Administrator Credentials (Only for bootstrapping / dev)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMeInProduction!123
